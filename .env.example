# The core local engine and tests do not require credentials.

# Used later by Vercel AI SDK harness adapters, AI Gateway, and Vercel Sandbox.
VERCEL_OIDC_TOKEN=
AI_GATEWAY_API_KEY=

# Optional direct-provider fallbacks. Do not commit real values.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local paths are resolved by the application when these are omitted.
ACM_DATA_DIR=
ACM_ARTIFACT_DIR=
