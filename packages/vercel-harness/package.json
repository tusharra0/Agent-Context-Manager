{
  "name": "@acm/vercel-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "pnpm --filter @acm/core build && pnpm --filter @acm/harness-port build && pnpm --filter @acm/hosted-evaluation build",
    "test": "vitest run --pool=forks --maxWorkers=1",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@acm/core": "workspace:*",
    "@acm/harness-port": "workspace:*",
    "@ai-sdk/harness": "1.0.91",
    "@ai-sdk/harness-claude-code": "1.0.94",
    "@ai-sdk/harness-codex": "1.0.93",
    "@ai-sdk/sandbox-vercel": "1.0.91",
    "@acm/hosted-evaluation": "workspace:*",
    "@vercel/sandbox": "3.2.0",
    "ai": "7.0.83",
    "ws": "8.21.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
